{
	"name": "sqldatabase",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"parameters": {
			"domain name": {
				"type": "string"
			},
			"database name": {
				"type": "string"
			},
			"user name": {
				"type": "string"
			},
			"password": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureSqlDatabase",
		"typeProperties": {
			"server": "@{linkedService().domain name}",
			"database": "@{linkedService().database name}",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "@{linkedService().user name}",
			"password": "@{linkedService().password}"
		}
	}
}